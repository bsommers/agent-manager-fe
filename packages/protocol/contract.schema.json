        "reqId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "targetHost": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
