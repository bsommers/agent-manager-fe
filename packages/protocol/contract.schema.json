              "input",
              "resize",
              "kill",
              "history",
              "broadcast",
              "approve",
              "snapshot"
            ]
          },
          "x-dropUnknown": true
        },
        "createdAt": {
          "type": "number"
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "enum": [
            "terminal",
            "sandbox",
            "pipeline"
