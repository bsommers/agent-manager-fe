        "layout": {
          "type": "object",
          "properties": {
            "height": {
              "type": "number"
            },
            "isFloating": {
              "type": "boolean"
            },
            "isMinimized": {
              "type": "boolean"
            },
            "width": {
              "type": "number"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "zIndex": {
              "type": "number"
            }
          },
          "required": [
            "isFloating"
          ]
        },
        "meta": {
          "type": "object",
          "x-maxDepth": 8,
          "x-maxChars": 65536
        },
        "mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": [
            "idle",
            "running",
            "thinking",
            "error",
            "disconnected"
